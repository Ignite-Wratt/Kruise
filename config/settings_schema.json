  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 30 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "text", "id": "brand_blurb", "label": "Footer blurb", "default": "Car air fresheners that smell like a candy store. Collect all six." }
