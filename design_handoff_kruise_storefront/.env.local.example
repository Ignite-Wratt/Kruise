# Shopify Storefront API — copy to .env.local and fill in
# .env.local is git-ignored. Never commit real tokens.

# Your store's myshopify domain (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=shopify-nqcwt4-sp.myshopify.com

# PUBLIC Storefront API access token (Admin → Settings → Apps and sales channels →
# Develop apps → your app → Configuration → Storefront API → enable scopes:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts
#   unauthenticated_read_checkouts
# then Install app → API credentials → Storefront API access token)
#
# This is the *public* Storefront token, not an Admin API token. Never put an
# Admin token in this file.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
