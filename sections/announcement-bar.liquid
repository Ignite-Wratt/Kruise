<div class="k-announce">
  {%- for block in section.blocks -%}
    {%- if forloop.index0 > 0 -%}<span class="k-dot" aria-hidden="true">•</span>{%- endif -%}
    <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $35" }]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping over $35" } },
      { "type": "message", "settings": { "text": "New drop: Cherry Bombastic 🍒" } },
      { "type": "message", "settings": { "text": "Collect all 6 scents" } }
    ]
  }
}
{% endschema %}
