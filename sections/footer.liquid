<footer class="k-footer">
  <div class="k-wrap">
    <div class="k-footer__cols">
      <div>
        <div class="k-footer__mark">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: height: 120 }}" alt="{{ shop.name | escape }}" style="height:34px;width:auto;display:block">
          {%- else -%}
            {{ shop.name | upcase }}
          {%- endif -%}
        </div>
        <p class="k-footer__blurb">{{ settings.brand_blurb }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div class="k-footer__h">{{ block.settings.heading }}</div>
          <div class="k-footer__links">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="k-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <div style="display:flex;gap:18px">
        {%- for link in section.settings.legal_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [{ "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" }],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "heading": "Shop" } },
      { "type": "column", "settings": { "heading": "Help" } },
      { "type": "column", "settings": { "heading": "Connect" } }
    ]
  }
}
{% endschema %}
