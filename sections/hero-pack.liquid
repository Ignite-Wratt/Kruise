<section class="k-hero" style="background:{{ section.settings.bg }}">
  <div class="k-hero__in">
    <div>
      {%- if section.settings.badge != blank -%}<div class="k-pill">{{ section.settings.badge }}</div>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p class="k-hero__sub">{{ section.settings.subheading }}</p>
      <div class="k-hero__ctas">
        {%- if section.settings.cta1_label != blank -%}<a class="kbtn kbtn--primary kbtn--lg" href="{{ section.settings.cta1_link }}">{{ section.settings.cta1_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="kbtn kbtn--outline kbtn--lg" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
      {%- if section.settings.trust != blank -%}
        <div class="k-hero__trust">
          {%- assign bits = section.settings.trust | split: '|' -%}
          {%- for bit in bits -%}<span>{{ bit | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="k-hero__art">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="420" style="border:4px solid var(--border-ink);border-radius:34px;box-shadow:var(--shadow-pop)">
      {%- else -%}
        <div class="k-hero__packs">
          <img src="{% if section.settings.pack_left != blank %}{{ section.settings.pack_left | image_url: width: 500 }}{% else %}{{ 'pack-tropic-punch.png' | asset_url }}{% endif %}" alt="Kruise vent clip pack">
          <img src="{% if section.settings.pack_center != blank %}{{ section.settings.pack_center | image_url: width: 600 }}{% else %}{{ 'pack-cherry-bombastic.png' | asset_url }}{% endif %}" alt="Kruise vent clip pack">
          <img src="{% if section.settings.pack_right != blank %}{{ section.settings.pack_right | image_url: width: 500 }}{% else %}{{ 'pack-cotton-cloud.png' | asset_url }}{% endif %}" alt="Kruise vent clip pack">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#fef7d8" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "New drop 🍒" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Smells like summer. All drive long." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clip it to the vent and let it rip. Juicy, loud candy-shop scents that stay fresh for 45+ days." },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Shop the drop" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Take the scent quiz" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "trust", "label": "Trust line (separate with |)", "default": "🌿 Non-toxic | ♻️ Refillable | ⭐ 4.9 / 5" },
    { "type": "header", "content": "Artwork" },
    { "type": "image_picker", "id": "image", "label": "Hero image (overrides the pack trio)" },
    { "type": "image_picker", "id": "pack_left", "label": "Left pack (defaults to Tropic Punch)" },
    { "type": "image_picker", "id": "pack_center", "label": "Center pack (defaults to Cherry Bombastic)" },
    { "type": "image_picker", "id": "pack_right", "label": "Right pack (defaults to Cotton Cloud)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
