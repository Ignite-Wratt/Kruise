<div class="k-page">
  <div class="k-page__head"><h1>{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 9 -%}
    <div class="k-grid k-grid--3">
      {%- for article in blog.articles -%}
        <a class="k-review" href="{{ article.url }}">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" style="border-radius:16px;border:2px solid var(--border-ink);margin-bottom:14px" loading="lazy">
          {%- endif -%}
          <div class="k-review__quote">{{ article.title }}</div>
          <div class="k-review__by">{{ article.published_at | date: '%b %d, %Y' }}</div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="k-pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog" }
{% endschema %}
