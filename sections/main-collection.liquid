<div class="k-page">
  <div class="k-page__head">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="k-rte" style="max-width:640px;margin:0 auto">{{ collection.description }}</div>{%- endif -%}
  </div>
  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="k-grid k-grid--{{ section.settings.columns }}">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="k-pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="k-rte" style="text-align:center">{{ 'collections.general.no_products' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ]
}
{% endschema %}
