<section class="k-news" style="background:{{ section.settings.bg }}">
  <div class="k-news__in">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required aria-label="Email">
      <button type="submit" class="kbtn kbtn--accent kbtn--lg">{{ section.settings.button }}</button>
    {%- endform -%}
    {%- if form.posted_successfully? -%}
      <p class="k-news__note">{{ 'general.newsletter.success' | t }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#2e4699" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 15% off ur first clip" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the club for early drops, restocks, and secret flavors before anyone else." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
