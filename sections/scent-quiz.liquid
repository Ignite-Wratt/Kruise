{%- comment -%}
  Scent quiz page. Content (questions, scent copy) is static/editorial.
  Each scent resolves its cart variant from the chosen collection by matching
  product.metafields.custom.flavor — the same convention product-card.liquid uses —
  so Add-to-cart hits the real Shopify cart once products carry that metafield.
{%- endcomment -%}
{%- assign coll = collections[section.settings.collection] -%}
{%- capture fmap -%};{% for p in coll.products %}{% assign pf = p.metafields.custom.flavor | downcase | strip %}{% if pf != blank %}{{ pf }}={{ p.selected_or_first_available_variant.id }};{% endif %}{% endfor %}{%- endcapture -%}
{%- assign vid_cherry    = fmap | split: ';cherry='    | last | split: ';' | first -%}
{%- assign vid_sky       = fmap | split: ';sky='       | last | split: ';' | first -%}
{%- assign vid_tangerine = fmap | split: ';tangerine=' | last | split: ';' | first -%}
{%- assign vid_wave      = fmap | split: ';wave='      | last | split: ';' | first -%}
{%- assign vid_blueberry = fmap | split: ';blueberry=' | last | split: ';' | first -%}
{%- assign vid_lime      = fmap | split: ';lime='      | last | split: ';' | first -%}

<section class="kq-hero">
  <div class="k-pill" style="justify-content:center">{{ section.settings.eyebrow }}</div>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
  <div class="kq-meta">
    {%- assign metabits = section.settings.meta | split: '|' -%}
    {%- for bit in metabits -%}<span>{{ bit | strip }}</span>{%- unless forloop.last -%}<span>·</span>{%- endunless -%}{%- endfor -%}
  </div>
</section>

<section class="kq-stage">
  <div class="kq-card" id="quizCard">
    <div class="kq-bar"><div class="kq-steps" id="quizSteps"></div><div class="kq-count" id="quizCount"></div></div>
    <h2 class="kq-q" id="quizQ"></h2>
    <p class="kq-hint" id="quizHint"></p>
    <div class="kq-opts" id="quizOpts"></div>
    <div class="kq-foot"><button class="kq-text" id="quizBack" disabled>&larr; Back</button><a class="kq-text" href="#allScents" style="text-decoration:none">Skip &mdash; just show me all six &rarr;</a></div>
  </div>
  <div class="kq-result" id="quizResult" hidden></div>
</section>

<section class="kq-all" id="allScents">
  <div class="kq-all__head">
    <h2 class="k-h2">{{ section.settings.all_heading }}</h2>
    <p>{{ section.settings.all_subheading }}</p>
  </div>
  <div class="kq-grid" id="scentGrid"></div>
</section>

<script type="application/json" id="kruise-quiz-data">
{
 "mode": "shopify",
 "scents": [
  { "key": "bomb", "name": "Cherry Bombastic", "flavor": "cherry", {% if vid_cherry != blank %}"variantId": {{ vid_cherry }}, {% endif %}"image": "{{ 'pack-cherry-bombastic.png' | asset_url }}", "mood": "Loud & sweet", "notes": ["Juicy Cherry","Sour Pop"], "sweet": 5, "price": "$12.00", "blurb": "Loud, juicy, a little sour — like tearing into a bag of cherry laces at a red light." },
  { "key": "cloud", "name": "Cotton Cloud", "flavor": "sky", {% if vid_sky != blank %}"variantId": {{ vid_sky }}, {% endif %}"image": "{{ 'pack-cotton-cloud.png' | asset_url }}", "mood": "Soft & sugary", "notes": ["Cotton Candy","Vanilla"], "sweet": 4, "price": "$12.00", "blurb": "Fairground candy floss over warm vanilla. Gentle enough for the school run, sweet enough to get noticed." },
  { "key": "tropic", "name": "Tropic Punch", "flavor": "tangerine", {% if vid_tangerine != blank %}"variantId": {{ vid_tangerine }}, {% endif %}"image": "{{ 'pack-tropic-punch.png' | asset_url }}", "mood": "Bright & juicy", "notes": ["Pineapple","Orange"], "sweet": 4, "price": "$12.00", "blurb": "Ripe pineapple and freshly squeezed orange. Windows down, playlist up, nowhere to be." },
  { "key": "tsunami", "name": "Tsunami Breeze", "flavor": "wave", {% if vid_wave != blank %}"variantId": {{ vid_wave }}, {% endif %}"image": "{{ 'pack-tsunami-breeze.png' | asset_url }}", "mood": "Cool & salty", "notes": ["Sea Salt","Fresh Air"], "sweet": 1, "price": "$12.00", "blurb": "Cold sea air and clean salt. The 6am surf run, bottled and clipped to your vent." },
  { "key": "clean", "name": "Clean Machine", "flavor": "blueberry", {% if vid_blueberry != blank %}"variantId": {{ vid_blueberry }}, {% endif %}"image": "{{ 'pack-clean-machine.png' | asset_url }}", "mood": "Crisp & clean", "notes": ["Fresh Linen","Clean Soap"], "sweet": 2, "price": "$12.00", "blurb": "Fresh linen and clean soap. Smells like the car just came out of the detailer." },
  { "key": "coconut", "name": "Coconut Bliss", "flavor": "lime", {% if vid_lime != blank %}"variantId": {{ vid_lime }}, {% endif %}"image": "{{ 'pack-coconut-bliss.png' | asset_url }}", "mood": "Creamy & tropical", "notes": ["Coconut","Pineapple"], "sweet": 3, "price": "$12.00", "blurb": "Creamy coconut poured over sharp pineapple. Holiday mode, all year round." }
 ],
 "questions": [
  { "q": "Where is this clip living?", "hint": "Pick the drive you do most.", "opts": [
    { "label": "The daily commute", "sub": "Traffic, coffee, same podcast", "flavor": "blueberry", "score": { "clean": 3, "cloud": 1 } },
    { "label": "Long road trips", "sub": "Snacks, playlists, no ETA", "flavor": "tangerine", "score": { "tropic": 3, "bomb": 1 } },
    { "label": "Beach and gym runs", "sub": "Wet towels are a fact of life", "flavor": "wave", "score": { "tsunami": 3, "coconut": 1 } },
    { "label": "School run duty", "sub": "Small people, loud opinions", "flavor": "sky", "score": { "cloud": 3, "bomb": 1 } }
  ] },
  { "q": "Snack aisle. You grab…", "hint": "Be honest.", "opts": [
    { "label": "Cherry laces", "sub": "Sweet with a sour bite", "flavor": "cherry", "score": { "bomb": 3 } },
    { "label": "Candy floss", "sub": "Pure spun sugar", "flavor": "sky", "score": { "cloud": 3 } },
    { "label": "Pineapple chunks", "sub": "Sharp, tropical, sticky", "flavor": "tangerine", "score": { "tropic": 2, "coconut": 2 } },
    { "label": "Fresh mint gum", "sub": "Nothing sweet, thanks", "flavor": "lime", "score": { "clean": 2, "tsunami": 2 } }
  ] },
  { "q": "How loud should it be?", "hint": "Scent volume, not stereo volume.", "opts": [
    { "label": "Barely there", "sub": "Just not stale", "flavor": "blueberry", "score": { "clean": 3, "tsunami": 2 } },
    { "label": "Somewhere in the middle", "sub": "Noticeable, not shouty", "flavor": "lime", "score": { "coconut": 2, "tropic": 1, "cloud": 1 } },
    { "label": "Turn it all the way up", "sub": "People should comment", "flavor": "cherry", "score": { "bomb": 3, "tropic": 1 } }
  ] },
  { "q": "Your car right now is…", "hint": "Last one, promise.", "opts": [
    { "label": "Fresh out the wash", "sub": "Vacuumed. Twice.", "flavor": "blueberry", "score": { "clean": 3 } },
    { "label": "Lovingly lived in", "sub": "Gym bag included", "flavor": "wave", "score": { "tsunami": 2, "clean": 1 } },
    { "label": "Permanent summer", "sub": "Sand in the footwell", "flavor": "lime", "score": { "coconut": 3, "tropic": 1 } },
    { "label": "A cosy little cocoon", "sub": "Blanket on the back seat", "flavor": "cherry", "score": { "cloud": 2, "bomb": 2 } }
  ] }
 ]
}
</script>
<script src="{{ 'kruise-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scent quiz",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Scent quiz" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which Kruise are you?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Four questions, twenty seconds, one clip that smells exactly like you. No wrong answers — only six very good ones." },
    { "type": "text", "id": "meta", "label": "Meta line (separate with |)", "default": "4 questions | Instant match | 45+ days per clip" },
    { "type": "collection", "id": "collection", "label": "Scent collection (for Add-to-cart)", "info": "Products need a custom.flavor metafield (cherry, sky, tangerine, wave, blueberry, lime) to wire the cart." },
    { "type": "text", "id": "all_heading", "label": "All-scents heading", "default": "All six scents" },
    { "type": "textarea", "id": "all_subheading", "label": "All-scents subheading", "default": "Every Kruise clip lasts 45+ days, fits any vent, and costs $12. The only real decision is what your car smells like." }
  ],
  "presets": [{ "name": "Scent quiz" }]
}
{% endschema %}
